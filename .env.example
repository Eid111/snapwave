# SnapWave Environment Configuration
HOST=127.0.0.1
PORT=8080
DEBUG=false
APP_TITLE="SnapWave Video & Audio Downloader"

# Set a unique password of at least 16 characters before starting the app.
ADMIN_PASSWORD=

# Use * for public demo, or a comma-separated allowlist in production
CORS_ORIGINS=*

# Enable only when the app sits behind a trusted reverse proxy
TRUST_PROXY=false
